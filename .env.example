# Bu dosyayı .env olarak kopyalayıp doldurun. .env git'e eklenmez.
# Her ayar config.py içindeki alan adının BÜYÜK HARFLİ halidir.

# ─── CSMS Bağlantısı ─────────────────────────────────────────────────────────
CSMS_URL=wss://your-csms-domain.com/ws/CP-1
CHARGE_BOX_ID=CP-1
BASIC_AUTH_USER=CP-1
BASIC_AUTH_PASSWORD=change-me

# ─── NFC ─────────────────────────────────────────────────────────────────────
# Her şarj oturumu kart okutularak başlar/biter. Kartın UID'si (hex) CSMS'e
# idTag olarak gönderilir. CSMS'te farklı bir idTag tanımlıysa eşleyin:
#   NFC_ID_TAG_MAP=97350E07:benim-idtagim,11223344:diger-tag
NFC_ID_TAG_MAP=
NFC_ENABLED=true

# ─── Donanım ─────────────────────────────────────────────────────────────────
# auto: Pi'de bulunan donanımı kullan, eksikleri simüle et
# pi  : sadece gerçek donanım (eksikse hata ver) — sahada bunu kullanın
# sim : tamamen simülasyon (masaüstü)
HARDWARE_MODE=auto
MAX_CURRENT_A=16
NEXTION_PORT=/dev/serial0

# Pilot ölçüm kalibrasyonu (şematik: R7=200k, R6=56k, R5=47k, Vref=3.3V)
# CP_LOW_VOLTAGE=-12.0
# CP_THRESHOLD_A=10.5
# CP_THRESHOLD_B=7.5
# CP_THRESHOLD_C=4.5
# CP_THRESHOLD_D=1.5
# PP_REQUIRED=false

# ─── Enerji tahmini (kartta sayaç yok) ────────────────────────────────────────
# Güç = teklif edilen akım × gerilim × faz (yalnızca araç C durumundayken)
# NOMINAL_VOLTAGE=230
# PHASES=1

# ─── Ücretlendirme ───────────────────────────────────────────────────────────
COST_PER_KWH=0.19
CURRENCY=$
